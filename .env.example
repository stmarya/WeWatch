# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Main WeWatch authentication and local user database.
# Use a random value of at least 32 bytes in every non-development deployment.
WEBWATCH_SESSION_SECRET=
WEBWATCH_COOKIE_SECURE=false
WEBWATCH_USERS_DB=users.db

# WebRTC_Meet: set a random long token before exposing port 5001.
WEBRTC_ADMIN_TOKEN=
WEBRTC_SECRET_KEY=
WEBRTC_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5001,http://127.0.0.1:5000,http://127.0.0.1:5001
WEBRTC_REQUIRE_JOIN_TOKEN=false
WEBRTC_ROOM_NAME=gmeet_room
WEBRTC_MAX_PARTICIPANTS=600
WEBRTC_ALLOW_UNSAFE_WERKZEUG=true
REDIS_URL=redis://localhost:6379/0
WEBRTC_REQUIRE_SHARED_STATE=false
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=ws://localhost:7880
DESKTOP_AGENT_TOKEN=
DESKTOP_AGENT_IDENTITY=workstation-01
DESKTOP_AGENT_TARGET_IDENTITY=
DESKTOP_AGENT_ALLOW_DANGEROUS=false
DESKTOP_AGENT_ALLOWED_PROCESSES=
FACE_MISSING_GRACE_SECONDS=30
POSE_PRESENCE_GRACE_SECONDS=3
PHONE_DETECTION_THRESHOLD=0.55

# --- Accounts -------------------------------------------------------------
# Public base URL used in email links (required in production; prevents Host-header spoofing).
WEBWATCH_PUBLIC_URL=http://localhost:5000
# Leave empty for SQLite (WEBWATCH_USERS_DB). Use PostgreSQL for multiple replicas:
# WEBWATCH_DATABASE_URL=postgresql://wewatch:change-me@localhost:5432/wewatch
WEBWATCH_DATABASE_URL=
# Block login until the email is verified (recommended: true in production).
WEBWATCH_REQUIRE_EMAIL_VERIFICATION=false
# Uploaded profile photos (outside static/). Defaults to ./uploads
WEBWATCH_UPLOAD_DIR=
# Auth rate limits are shared via Redis when set (defaults to REDIS_URL).
WEBWATCH_RATE_LIMIT_REDIS_URL=
# Where "Gabung meeting" sends signed-in users.
WEBRTC_CLIENT_URL=http://localhost:5001/

# --- Email (verification, password reset) ----------------------------------
# smtp | console (logs links; development) | memory (tests). Default: smtp if SMTP_HOST set.
WEBWATCH_MAIL_BACKEND=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=WeWatch <no-reply@example.com>
