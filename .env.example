# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBWATCH_SAVE_ALERT_IMAGES=false
WEBWATCH_LOG_MOOD=false

# Local development only; keep the dashboard and signaling server on loopback.
WEBWATCH_ENV=development
WEBWATCH_HOST=127.0.0.1
WEBWATCH_COOKIE_SECURE=false
WEBWATCH_SESSION_SECRET=

# WebRTC_Meet. Use distinct random secrets of at least 32 characters.
WEBRTC_ADMIN_TOKEN=
WEBRTC_SECRET_KEY=
WEBRTC_HOST=127.0.0.1
WEBRTC_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5001,http://127.0.0.1:5000,http://127.0.0.1:5001
WEBRTC_REQUIRE_JOIN_TOKEN=true
WEBRTC_ROOM_NAME=gmeet_room
WEBRTC_MAX_PARTICIPANTS=600
WEBRTC_ALLOW_UNSAFE_WERKZEUG=false
WEBRTC_REQUIRE_SHARED_STATE=false

# Required by docker-compose.scale.yml. Use a URL-encoded Redis password in REDIS_URL.
REDIS_PASSWORD=
REDIS_URL=

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=ws://localhost:7880
TURN_STATIC_AUTH_SECRET=
TURN_REALM=

# Enable remote desktop only on trusted, encrypted connections.
DESKTOP_AGENT_TOKEN=
DESKTOP_AGENT_IDENTITY=workstation-01
DESKTOP_AGENT_TARGET_IDENTITY=
DESKTOP_AGENT_ALLOW_DANGEROUS=false
DESKTOP_AGENT_ALLOW_SCREENSHOTS=false
DESKTOP_AGENT_ALLOWED_PROCESSES=

# 0 disables cleanup in development. Production requires explicit positive values.
WEWATCH_PRIVACY_ACKNOWLEDGED=false
WEBWATCH_RETENTION_GALLERY_DAYS=0
WEBWATCH_RETENTION_FACE_DAYS=0
WEBWATCH_RETENTION_MOOD_DAYS=0
WEBWATCH_RETENTION_ATTENDANCE_DAYS=0

FACE_MISSING_GRACE_SECONDS=30
POSE_PRESENCE_GRACE_SECONDS=3
PHONE_DETECTION_THRESHOLD=0.55