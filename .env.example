# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WebRTC_Meet: set a random long token before exposing port 5001.
WEBRTC_ADMIN_TOKEN=
WEBRTC_SECRET_KEY=
WEBWATCH_SESSION_SECRET=
WEBRTC_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5001,http://127.0.0.1:5000,http://127.0.0.1:5001
WEBRTC_REQUIRE_JOIN_TOKEN=true
WEBRTC_ROOM_NAME=gmeet_room
WEBRTC_MAX_PARTICIPANTS=600
WEBRTC_ALLOW_UNSAFE_WERKZEUG=true
REDIS_URL=redis://localhost:6379/0
WEBRTC_REQUIRE_SHARED_STATE=false
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=ws://localhost:7880
DESKTOP_AGENT_TOKEN=
DESKTOP_AGENT_IDENTITY=workstation-01
DESKTOP_AGENT_TARGET_IDENTITY=
DESKTOP_AGENT_ALLOW_DANGEROUS=false
DESKTOP_AGENT_ALLOWED_PROCESSES=
FACE_MISSING_GRACE_SECONDS=30
POSE_PRESENCE_GRACE_SECONDS=3
PHONE_DETECTION_THRESHOLD=0.55
# Privacy-by-default: explicitly opt in after informed consent.
DESKTOP_AGENT_ALLOW_REMOTE_CONTROL=false
ALERT_CAPTURE_ENABLED=false
TELEGRAM_UPLOAD_ENABLED=false
MOOD_LOG_ENABLED=false
VOICE_CLOUD_ENABLED=false
RPPG_EXPERIMENTAL_ENABLED=false
WEBWATCH_COOKIE_SECURE=false
# Device ticket: issue role=agent with target_identity using /api/room-token.
DESKTOP_AGENT_JOIN_TOKEN=
WEBRTC_ALLOW_STATIC_AGENT_TOKEN=false

# Bind to loopback by default. Expose only behind TLS/firewall with explicit opt-in.
WEBWATCH_HOST=127.0.0.1
WEBRTC_HOST=127.0.0.1

# Phase 1 platform control plane: independent from legacy camera/meeting ports.
# Generate a DISTINCT private session secret (at least 32 characters).
PLATFORM_ENV=development
PLATFORM_SESSION_SECRET=
PLATFORM_PUBLIC_URL=http://127.0.0.1:5002
PLATFORM_PORT=5002
# Blank paths use private instance/platform defaults. Never use public/static paths.
PLATFORM_DATABASE_PATH=
PLATFORM_MAIL_DIRECTORY=
# disabled (default), file (loopback development only), or smtp (STARTTLS required).
PLATFORM_MAIL_TRANSPORT=disabled
PLATFORM_MAIL_FROM=no-reply@wewatch.example
PLATFORM_SMTP_HOST=
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_USER=
PLATFORM_SMTP_PASSWORD=
